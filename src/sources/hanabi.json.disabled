{
  "_disabled": true,
  "_disabled_reason": "Upstream API removed. The old host api.hanabi.so is gone (404 on every path). Hanabi migrated to sandwich-api.hanabi.so which is (a) currently returning 503, and (b) a real-time WebSocket + /history event-stream + /search/{pubkey} model that streams individual sandwich TRANSACTIONS (keyed by `slot`) rather than a flat list of flagged validators. The simple Json GET handler can no longer consume it. Re-enable by renaming back to hanabi.json once a websocket/aggregation handler exists and the upstream is healthy.",
  "_new_api": {
    "websocket": "wss://sandwich-api.hanabi.so/",
    "history": "https://sandwich-api.hanabi.so/history",
    "search": "https://sandwich-api.hanabi.so/search/{pubkey}",
    "frontend": "https://hanabi.so/sandwiching"
  },
  "name": "hanabi",
  "url": "https://api.hanabi.so/validators/sandwiching-report",
  "contact_info": {
    "website": "https://hanabi.so/sandwiching"
  },
  "handler": "Json",
  "filters": [
    "?(@.flagged == true)"
  ],
  "record_path": "$..*",
  "pubkey_path": "$.vote",
  "reason_path": null,
  "name_path": "$.name"
}
